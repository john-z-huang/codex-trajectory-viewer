{
  "name": "codex-trajectory-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=23.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsc -p tsconfig.server.json && concurrently -k \"tsc -p tsconfig.server.json --watch\" \"node --watch server-dist/index.js\"",
    "dev:client": "vite --host 127.0.0.1",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build": "npm run build:server && vite build",
    "start": "node server-dist/index.js",
    "test": "npm run build:server && node --test"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-markdown": "^10.1.0",
    "vite": "latest"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "happy-dom": "^21.0.1",
    "typescript": "6.0.3"
  }
}
