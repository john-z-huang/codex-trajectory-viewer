{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "rootDir": "./server",
    "outDir": "./server-dist",
    "noEmitOnError": true,
    "types": ["node"],
    "skipLibCheck": true
  },
  "include": ["server/**/*.ts"],
  "exclude": ["server-dist", "src", "test"]
}
