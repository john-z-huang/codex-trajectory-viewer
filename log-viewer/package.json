{
  "name": "codex-trajectory-log-viewer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.13.0 || >=23.0.0" },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsc -p tsconfig.server.json && concurrently -k \"tsc -p tsconfig.server.json --watch\" \"node --watch server-dist/index.js\"",
    "dev:client": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "typecheck:server": "tsc -p tsconfig.server.json --noEmit",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "build": "npm run build:server && npm run build:client",
    "start": "node server-dist/index.js",
    "test": "npm run build:server && node --test test/*.test.js"
  },
  "dependencies": { "react": "19.3.1", "react-dom": "19.3.1" },
  "devDependencies": {
    "@vitejs/plugin-react": "6.1.2",
    "@types/node": "22.20.5",
    "concurrently": "10.0.6",
    "happy-dom": "21.0.1",
    "typescript": "6.0.3",
    "vite": "8.3.4"
  }
}
